# ╔══════════════════════════════════════════════════════════════╗
# ║  BIOKO HEALTH — Instalación Sanitaria                        ║
# ║  Hospital / Clínica / Puesto de Salud                        ║
# ║  Mismo paquete — solo cambia FACILITY_TYPE                   ║
# ╚══════════════════════════════════════════════════════════════╝

FLASK_ENV=installation
SECRET_KEY=GENERAR-CON-python3-c-import-secrets-print-secrets-token-hex-32
DATABASE_URL=mysql+pymysql://bioko_user:PASSWORD_LOCAL@localhost/bioko_health

# ── Identidad ─────────────────────────────────────────────────
FACILITY_CODE=HMGE-001
FACILITY_NAME=Hospital General de Malabo
FACILITY_TYPE=hospital
# FACILITY_TYPE opciones:
#   hospital  → todos los módulos clínicos
#   clinica   → módulos generales sin especialidades
#   puesto    → básico: consultas, vacunas, urgencias

FACILITY_MODE=installation
PROVINCIA_CODIGO=BN-BS

# ── Red local del edificio (tablets del personal) ─────────────
LAN_HOST=192.168.1.10
LAN_PORT=5000
LAN_URL=http://192.168.1.10

# ── Nodo provincial (único servidor al que se conecta) ────────
INTRANET_MODE=true
PROVINCIAL_NODE_URL=http://10.10.0.1:5000
INTRANET_CENTRAL_URL=http://10.10.0.1:5000
INTRANET_PULL_INTERVAL=30
INTRANET_RETRY_INTERVAL=10

# Token compartido con el nodo provincial
SYNC_API_TOKEN=TOKEN-COMPARTIDO-TODA-LA-RED
SYNC_ENABLED=true
CENTRAL_SERVER_URL=http://10.10.0.1:5000
SYNC_HOUR=3
SYNC_MINUTE=0

# Pool de conexiones BD
# Puesto (1-3 tablets):   DB_POOL_SIZE=5
# Clinica (4-10 tablets): DB_POOL_SIZE=10
# Hospital (10+):         DB_POOL_SIZE=15
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=15
OUTBREAK_THRESHOLD=5
